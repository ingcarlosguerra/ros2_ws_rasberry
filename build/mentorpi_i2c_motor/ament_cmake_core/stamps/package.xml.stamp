<?xml version="1.0"?>

<package format="3">

  <name>mentorpi_i2c_motor</name>

  <version>0.0.1</version>

  <description>
    ROS 2 differential drive controller
    for Hiwonder EMM I2C motor driver.
  </description>

  <maintainer email="carlos@unimilitar.edu.co">
    Carlos Guerra
  </maintainer>

  <license>Apache-2.0</license>


  <buildtool_depend>
    ament_cmake
  </buildtool_depend>


  <depend>
    rclcpp
  </depend>


  <depend>
    geometry_msgs
  </depend>


  <depend>
    nav_msgs
  </depend>


  <depend>
    tf2
  </depend>


  <depend>
    tf2_ros
  </depend>


  <export>

    <build_type>
      ament_cmake
    </build_type>

  </export>

</package>
